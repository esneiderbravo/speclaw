{
  "name": "@esneiderbravo/speclaw",
  "version": "0.4.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Where specs become law. A self-contained MCP suite that turns any repo into a spec-driven, agent-ready project: its own constitution (foundation), its own local code graph (Compass), its own spec-driven workflow (Lawbook), and opt-in skill packs (Tools). No external CLIs, no LLM to install.",
  "keywords": [
    "mcp",
    "mcp-server",
    "spec-driven-development",
    "ai-agents",
    "claude-code",
    "cursor",
    "code-graph",
    "skills"
  ],
  "author": "Esneider Bravo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esneiderbravo/speclaw.git"
  },
  "homepage": "https://github.com/esneiderbravo/speclaw#readme",
  "bugs": {
    "url": "https://github.com/esneiderbravo/speclaw/issues"
  },
  "type": "module",
  "bin": {
    "speclaw": "dist/cli/index.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "ATTRIBUTION.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "brand": "node scripts/render-brand.mjs",
    "start": "node dist/cli/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "prettier --check . && eslint .",
    "budget:calibrate": "node scripts/budget-calibrate.mjs",
    "pretest": "tsc -p tsconfig.test.json && node scripts/prep-test-assets.mjs",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 --test-coverage-exclude='dist-test/test/**' --test-coverage-exclude='dist/**' 'dist-test/test/**/*.test.js'",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "picocolors": "^1.1.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.25.10",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0"
  }
}
