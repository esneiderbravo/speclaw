node_modules/
dist/
dist-test/
.speclaw/
*.tgz
*.log
.DS_Store

# Local agent/MCP wiring — machine-specific, not source.
.mcp.json

# speclaw managed-file refresh backups
*.bak

# speclaw workflow content (regenerated by init/update; never commit)
ai-specs/

# ...and the per-IDE symlinks into it, for the same reason. They are generated,
# and committing them publishes links that dangle for everyone else: ai-specs/
# is ignored, so a clone has the link but never its target. GitHub refuses to
# stage an action whose tree contains one, which breaks every consumer of
# `uses: esneiderbravo/speclaw@vN`.
.agents/agents
.agents/skills
.claude/agents
.claude/commands
.claude/rules/speclaw
.claude/skills
.cursor/agents
.cursor/commands
.cursor/rules
.cursor/skills

# Roadmap analysis — working notes, not part of the published docs
docs/roadmap/

# speclaw agent MCP config (per-developer; regenerated by init)
.cursor/mcp.json

# Local Claude overrides (machine-specific)
.claude/settings.local.json
