{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "speclaw",
            "tool": "speclaw_check",
            "timeout": 5,
            "input": {
              "projectPath": "${cwd}",
              "event": "${hook_event_name}",
              "toolName": "${tool_name}",
              "payload": {
                "hook_event_name": "${hook_event_name}",
                "tool_name": "${tool_name}",
                "tool_input": {
                  "file_path": "${tool_input.file_path}"
                }
              }
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "speclaw",
            "tool": "speclaw_check",
            "timeout": 5,
            "input": {
              "projectPath": "${cwd}",
              "event": "${hook_event_name}",
              "toolName": "${tool_name}",
              "payload": {
                "hook_event_name": "${hook_event_name}",
                "tool_name": "${tool_name}",
                "tool_input": {
                  "file_path": "${tool_input.file_path}"
                }
              }
            }
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "speclaw",
            "tool": "speclaw_check",
            "timeout": 5,
            "input": {
              "projectPath": "${cwd}",
              "event": "${hook_event_name}",
              "toolName": "${tool_name}",
              "payload": {
                "hook_event_name": "${hook_event_name}",
                "tool_name": "${tool_name}",
                "tool_input": {
                  "file_path": "${tool_input.file_path}"
                }
              }
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "speclaw",
            "tool": "speclaw_check",
            "timeout": 5,
            "input": {
              "projectPath": "${cwd}",
              "event": "${hook_event_name}",
              "toolName": "${tool_name}",
              "payload": {
                "hook_event_name": "${hook_event_name}",
                "tool_name": "${tool_name}",
                "tool_input": {
                  "file_path": "${tool_input.file_path}"
                }
              }
            }
          }
        ]
      }
    ]
  }
}
